# Copy to .env and fill in. Never commit .env.
#
# Generate random secrets with:   openssl rand -hex 32

# --- Site ---------------------------------------------------------------------
# Your domain in production (Caddy gets an HTTPS certificate automatically),
# or http://localhost when running locally.
SITE_ADDRESS=http://localhost
# true in production (HTTPS). Must be false for http://localhost.
COOKIE_SECURE=false

# --- Internal secrets (random, never shared) ----------------------------------
INTERNAL_TOKEN=
MONGO_USER=cortex
MONGO_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# --- Firebase (Authentication > Sign-in method > Google) ----------------------
# Project settings > General > Your apps > Web app config.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# --- AI providers ---------------------------------------------------------------
# Required: https://console.groq.com/keys (free tier)
GROQ_API_KEY=
# Vision + PDF Q&A: https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=
# Web search: https://app.tavily.com (free tier, 1000 searches/month)
TAVILY_API_KEY=
# Optional: https://openrouter.ai/keys — then e.g. CODING_MODEL=openrouter:deepseek/deepseek-chat
OPENROUTER_API_KEY=
# Models as "provider:model" (providers: groq, google, openrouter).
CHAT_MODEL=groq:openai/gpt-oss-120b
CODING_MODEL=groq:openai/gpt-oss-120b
DOCUMENTS_MODEL=groq:openai/gpt-oss-120b
ROUTER_MODEL=groq:openai/gpt-oss-20b
FALLBACK_MODEL=groq:openai/gpt-oss-20b

# --- Payments (Razorpay TEST mode: keys start with rzp_test_) -----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<your-domain>/api/billing/webhook,
# events payment.captured + payment.failed. Paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# --- Limits ---------------------------------------------------------------------
STARTING_CREDITS=50
# Max agent runs per day across all users; protects your free API quotas.
DAILY_REQUEST_CAP=1500
