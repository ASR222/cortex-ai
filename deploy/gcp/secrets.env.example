# Copy to secrets.env (git-ignored), fill in, then run ./setup.sh, which
# uploads each non-empty value to Secret Manager. Generate random values with:
#   openssl rand -hex 32

INTERNAL_TOKEN=
# MongoDB Atlas (M0 free): Database > Connect > Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Upstash Redis (free): note the rediss:// (TLS) scheme
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
QDRANT_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
