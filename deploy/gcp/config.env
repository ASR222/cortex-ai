# Non-secret deployment settings for Google Cloud. Fill these in and commit
# them: nothing here is a secret. (Secrets go in secrets.env, which is never
# committed, and from there into Secret Manager.)

# Google Cloud project
PROJECT_ID=multi-agent-ai-platform-a63ca
PROJECT_NUMBER=720170616128        # printed by setup.sh
REGION=asia-south1       # Mumbai; pick the region closest to your users

# GitHub repository allowed to deploy (owner/name)
GITHUB_REPO=ASR222/cortex-ai

# Cloud Storage bucket for uploads and generated files (globally unique name)
GCS_BUCKET=cortex-ai-files-asr222

# Firebase web config (public by design; see frontend/firebase.js)
FIREBASE_PROJECT_ID=multi-agent-ai-platform-a63ca
VITE_FIREBASE_API_KEY=AIzaSyDKIPEy-zXPu7wSYlp3LeTUK9MIj0jzyq0
VITE_FIREBASE_AUTH_DOMAIN=multi-agent-ai-platform-a63ca.firebaseapp.com
VITE_FIREBASE_APP_ID=1:720170616128:web:b8137c1d1347937eef26a5

# Razorpay public key id (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_TiLtBTvnfoR4PL

# Qdrant Cloud cluster URL, e.g. https://xxxx.asia-south1-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=https://186d3c17-f246-4d99-a278-59f5249143b2.europe-west3-0.gcp.cloud.qdrant.io:6333

# App settings
STARTING_CREDITS=50
DAILY_REQUEST_CAP=1500

# Models as "provider:model" (providers: groq, google, openrouter)
CHAT_MODEL=groq:openai/gpt-oss-120b
CODING_MODEL=groq:openai/gpt-oss-120b
DOCUMENTS_MODEL=groq:openai/gpt-oss-120b
ROUTER_MODEL=groq:openai/gpt-oss-20b
FALLBACK_MODEL=groq:openai/gpt-oss-20b
